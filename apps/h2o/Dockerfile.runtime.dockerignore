# Build context for apps/h2o/Dockerfile.runtime (repository root). No local state, env files, legacy
# archive, other apps, tests or build output enter the image.
**/node_modules
**/.next
**/.turbo
apps/h2o/.public-renderer
.git
**/.env
**/.env.*
!**/.env.example
legacy-reference
spike
docs
apps/syed-ai
apps/*/test
**/__tests__
**/__dbtests__
**/*.test.ts
**/*.test.tsx
**/*.dbtest.ts
apps/h2o/release/evidence
apps/h2o/media
# Image slimming: the page documents never enter the runtime image (Payload is the page source; the importer
# reads a mounted checkout). Excluded here, before any COPY, so no layer ever carries them.
apps/h2o/content/salmon/documents
