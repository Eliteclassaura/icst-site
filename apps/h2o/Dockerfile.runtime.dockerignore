# Build context for apps/h2o/Dockerfile.runtime (repository root). No local state, env files, legacy
# archive, other apps, tests or build output enter the image.
**/node_modules
**/.next
**/.turbo
apps/h2o/.public-renderer
.git
**/.env
**/.env.*
!**/.env.example
legacy-reference
spike
docs
apps/syed-ai
apps/*/test
**/__tests__
**/__dbtests__
**/*.test.ts
**/*.test.tsx
**/*.dbtest.ts
apps/h2o/media
# Only the client's own folder enters the image (see the `client` stage); other clients' folders do not.
# Other clients enter only as blocklists (the layer-2 gate needs them); their content, theme and manifests do not.
clients/*/content
clients/*/theme
!clients/icst/content
!clients/icst/theme
# The client's media folder (staged by media-sync) is part of its folder and enters the image; the build verifies it against MEDIA_INDEX.json.
clients/h2o/manifest.json
clients/example-industrial/manifest.json
clients/_template

# DEPLOY-PIPE-1: CI working files never enter the image build context
.prev-media
.media-apply.json
evidence
.github
