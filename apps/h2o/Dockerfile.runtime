# H2O unified runtime image — ONE Payload/Next application: public website (Payload-managed), /admin,
# /crm and the Payload APIs, on PostgreSQL. This is NOT the nginx static-release image
# (release/vps/Dockerfile), which stays the static rollback path.
#
# Build from the REPOSITORY ROOT:
#   docker build -f apps/h2o/Dockerfile.runtime \
#     --build-arg NODE_IMAGE=node:22.22.2-bookworm-slim@sha256:<reviewed digest> \
#     --build-arg NEXT_PUBLIC_SERVER_URL=https://<validation host> \
#     --build-arg H2O_REVISION=$(git rev-parse HEAD) \
#     -t h2o-runtime:<commit> .
#
# Pinning: the lockfile is used frozen (no upgrades); pnpm is the repository's packageManager version;
# the Node base MUST be pinned by digest by the Commander at build time (NODE_IMAGE has no digest default
# because a digest cannot be verified from inside the Factory). Node major/minor matches the tested 22.22.2.
#
# One image, three roles (same bytes, different command/env — see RUNTIME_MANIFEST.md):
#   web     node server.js                                   (default)
#   runner  node server.js  with H2O_PUBLISHING_RUNNER=1     (exactly one replica: the schedule coordinator)
#   migrate node node_modules/payload/bin.js migrate          (the single migration coordinator; a release
#                                                              step before web starts — never on startup)
#
# Image slimming (runtime image layer plan). The runner image is assembled from four independent layers,
# least- to most-frequently changing, each `COPY --link` so a layer is reused whenever its own input is
# unchanged, whatever changed below it:
#   1. base     node + pnpm                                   (changes with the Node pin)
#   2. deps     ONE production node_modules (pnpm deploy)     (changes with the lockfile / workspace packages)
#   3. media    public/ (+ MEDIA_IDENTITY.sha256 proof)       (changes when media changes)
#   4. content  content/ authorities, WITHOUT salmon/documents (changes when authorities change)
#   5. app      Next standalone server + .next + src/config   (changes every code release)
# Removed duplication: the standalone output's own traced copies of node_modules, public/ and content/ are
# not shipped (each exists once, in its own layer); salmon/documents is excluded from the build context
# (Dockerfile.runtime.dockerignore) instead of being deleted after a COPY (which never freed the bytes).
ARG NODE_IMAGE=node:22.22.2-bookworm-slim
FROM ${NODE_IMAGE} AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH NEXT_TELEMETRY_DISABLED=1 CI=1
RUN corepack enable && corepack prepare pnpm@10.28.0 --activate

# ── deps: workspace install (for the build) and the production closure (for the image). Inputs are the
# manifests, lockfile and workspace packages only — no application source — so a code-only release reuses it.
FROM base AS deps
WORKDIR /repo
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json .npmrc tsconfig.base.json ./
COPY apps/h2o/package.json apps/h2o/package.json
COPY packages ./packages
COPY tools ./tools
RUN pnpm install --frozen-lockfile --filter @factory/h2o...
# Production closure for web/runner (Next server externals) and the migrate/import/runner commands
# (Payload bin, db adapter, TS loader). Only package.json of the app exists here, so the closure is
# independent of application source.
RUN rm -rf /repo/deploy && pnpm --filter @factory/h2o deploy --prod --legacy /repo/deploy \
 && test -d /repo/deploy/node_modules/.pnpm \
 && sed -i 's/^prunedAt: .*/prunedAt: Thu, 01 Jan 1970 00:00:00 GMT/' /repo/deploy/node_modules/.modules.yaml
# ^ pnpm stamps the deploy time into .modules.yaml; pinning it makes a re-run with unchanged inputs byte-identical,
#   so BuildKit's content-addressed COPY reuses the ~1 GB deps layer even when this stage re-executes.

# ── media: public historical assets (LFS media, PDFs, fonts) plus their byte-identity proof.
FROM base AS media
WORKDIR /out/app/apps/h2o
COPY apps/h2o/public ./public
RUN cd /out/app && find apps/h2o/public -type f -print0 | LC_ALL=C sort -z | xargs -0 sha256sum > MEDIA_IDENTITY.sha256 \
 && test -s MEDIA_IDENTITY.sha256

# ── content: presentation/owner authorities the templates read (luxury models, media identities, contact,
# wave4 …). The page documents (salmon/documents) are not in the build context at all: in the payload
# runtime they come only from Payload, and the importer reads them from a mounted checkout.
FROM base AS content
WORKDIR /out/app/apps/h2o
COPY apps/h2o/content ./content
RUN test ! -e content/salmon/documents && test -s content/salmon/media-identities.json

# ── build: Next standalone build on top of the full workspace install.
FROM deps AS build
COPY apps/h2o ./apps/h2o
# Build-time variables. NEXT_PUBLIC_SERVER_URL is compiled into the bundle and has NO default (a deployable
# image must name its origin). The database/secret values are placeholders: `next build` does not connect.
ARG NEXT_PUBLIC_SERVER_URL
RUN test -n "$NEXT_PUBLIC_SERVER_URL" || (echo "NEXT_PUBLIC_SERVER_URL build arg is required" && exit 1)
ENV NEXT_PUBLIC_SERVER_URL=${NEXT_PUBLIC_SERVER_URL} \
    H2O_CONTENT_SOURCE=payload \
    DATABASE_URI=postgres://build:build@127.0.0.1:1/build \
    PAYLOAD_SECRET=build-time-placeholder-not-a-secret
RUN pnpm --filter @factory/h2o build:cms
# De-duplicate the standalone output against the shipped layers:
#  - public/ and content/ are traced into the standalone tree; they ship in the media/content layers.
#  - the traced node_modules/.pnpm entries that the production closure already contains become symlinks into
#    it (the Next server's hashed externals in .next/node_modules point at ../../../../node_modules/.pnpm/…);
#    entries the closure does not contain (traced-only, e.g. a dev-declared package the server bundles
#    reference) are kept as traced bytes. apps/h2o/node_modules comes from the closure (it provides `next`).
RUN set -eu; S=/repo/apps/h2o/.next/standalone; D=/repo/deploy/node_modules/.pnpm; \
    rm -rf "$S/apps/h2o/public" "$S/apps/h2o/content" "$S/apps/h2o/node_modules"; \
    kept=0; linked=0; \
    for p in "$S"/node_modules/.pnpm/*; do n=$(basename "$p"); [ "$n" = node_modules ] && continue; \
      if [ -d "$D/$n" ]; then rm -rf "$p"; ln -s "../../apps/h2o/node_modules/.pnpm/$n" "$p"; linked=$((linked+1)); \
      else kept=$((kept+1)); echo "traced-only: $n"; fi; done; \
    echo "standalone .pnpm: $linked linked to the production closure, $kept kept as traced bytes"

# ── runner: base → deps → media → content → app.
FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0 \
    H2O_CONTENT_SOURCE=payload \
    MEDIA_DIR=/data/media CONTENT_SNAPSHOT_DIR=/data/snapshot SEARCH_INDEX_DIR=/data/search \
    H2O_INDEXING_POLICY=private
RUN groupadd -g 1001 app && useradd -u 1001 -g app -m app && mkdir -p /data/media /data/snapshot /data/search && chown -R app:app /data
# 2. deps — the single production node_modules (migrate / import / runner commands and the server externals).
COPY --link --from=deps --chown=1001:1001 /repo/deploy/node_modules /app/apps/h2o/node_modules
# 3. media — public/ served read-only from the image, and its identity proof (/app/MEDIA_IDENTITY.sha256).
COPY --link --from=media --chown=1001:1001 /out/app/ /app/
# 4. content — authorities only.
COPY --link --from=content --chown=1001:1001 /out/app/ /app/
# 5. app — standalone server (de-duplicated), static assets, config + migrations source, TS config.
COPY --link --from=build --chown=1001:1001 /repo/apps/h2o/.next/standalone/ /app/
COPY --link --from=build --chown=1001:1001 /repo/apps/h2o/.next/static /app/apps/h2o/.next/static
COPY --link --from=build --chown=1001:1001 /repo/apps/h2o/src /app/apps/h2o/src
COPY --link --from=build --chown=1001:1001 /repo/apps/h2o/release/authority.mjs /repo/apps/h2o/release/public-build-config.json /app/apps/h2o/release/
COPY --link --from=build --chown=1001:1001 /repo/apps/h2o/tsconfig.json /app/apps/h2o/tsconfig.json
COPY --link --from=build --chown=1001:1001 /repo/tsconfig.base.json /app/tsconfig.base.json
# Revision label (metadata only, no layer). Commander passes the commit id it built from.
ARG H2O_REVISION=unknown
LABEL org.opencontainers.image.revision=${H2O_REVISION} \
      org.opencontainers.image.title="h2o-runtime"
# Persistent state: uploads (MEDIA_DIR), published snapshot and search index generations.
VOLUME ["/data/media", "/data/snapshot", "/data/search"]
USER app
WORKDIR /app/apps/h2o
EXPOSE 3000
# Readiness (database + promoted snapshot + search index). Liveness is /api/live/ (no dependencies).
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/api/ready/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server.js"]
