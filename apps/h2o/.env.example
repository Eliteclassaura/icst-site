# H2O staging only. No production value belongs in this file or in any deliverable.
DATABASE_URI=postgres://postgres:postgres@localhost:5432/h2o_staging
PAYLOAD_SECRET=generate-a-long-random-string
NEXT_PUBLIC_SERVER_URL=http://localhost:3200
MEDIA_DIR=
NEXT_TELEMETRY_DISABLED=1
EXTRA_ORIGINS=
# Payload GraphQL stays disabled unless this is '1' (securityDefaults).
PAYLOAD_GRAPHQL=

# CRM Typeform intake (CRM go-live). OFF unless exactly 1. Secret >= 24 chars from the secret store, never committed.
# The field map JSON for F22cAgx3 is F22CAGX3_RECOMMENDED_FIELD_MAP in src/crm/intake/typeform/config.ts.
H2O_CRM_TYPEFORM_INGEST_ENABLED=0
H2O_CRM_TYPEFORM_WEBHOOK_SECRET=
H2O_CRM_TYPEFORM_FIELD_MAP=
# CRM email M1 (Stalwart). Off until the owner says otherwise; staging = allowlist; production = off until cutover GO.
# Secrets (H2O_SMTP_PASS) come from the deployment environment only, never from a committed file.
H2O_EMAIL_MODE=off
H2O_EMAIL_ALLOWLIST=
H2O_EMAIL_FROM=
H2O_SALES_ALERT_TO=
H2O_EMAIL_CUSTOMER_ACK=off
H2O_SMTP_HOST=
H2O_SMTP_PORT=587
H2O_SMTP_USER=
H2O_SMTP_PASS=
H2O_SMTP_TLS_SERVERNAME=
# CRM email M3 (inbound replies over JMAP, internal network only). Off until Stalwart and DNS are live.
H2O_EMAIL_INBOUND=off
H2O_JMAP_HOST=
H2O_JMAP_PORT=443
# CRM Wave 1 import. ICS's own email domains (comma-separated): never an account, contacts flagged INTERNAL.
# Required before an import may create accounts (fails closed when empty). Optional pacing knobs follow.
H2O_OWN_EMAIL_DOMAINS=
# H2O_IMPORT_PAUSE_MS=2000
# H2O_IMPORT_MIN_FREE_MB=500
