// Regenerates data/library-seed.json from the sources in data/source (run: node --experimental-strip-types build-seed.mts).
import { createHash } from 'node:crypto'
import { readFileSync, writeFileSync } from 'node:fs'
import { parseE1, sequenceLabel } from './parse-e1.ts'

const dir = new URL('./data/', import.meta.url)
const rd = (n: string) => readFileSync(new URL(n, dir), 'utf8')
const sha = (s: string) => createHash('sha256').update(s).digest('hex')
const e1 = rd('source/E1_EXACT_SEQUENCE_STEPS_AND_COPY.md')
const e2d = rd('source/e2_draft_skeletons.json')
const e2t = rd('source/e2_topic_bank.json')
const steps = parseE1(e1)
const drafts = (JSON.parse(e2d) as { drafts: Array<Record<string, unknown>> }).drafts
const topics = (JSON.parse(e2t) as { topics: Array<Record<string, unknown>> }).topics
const skeletons = topics.map((t) => {
  const d = drafts.find((x) => x.topic_id === t.topic_id)
  if (!d) throw new Error(`no E2 draft for ${String(t.topic_id)}`)
  return { month_slot: t.month_slot, topic_id: t.topic_id, title: t.title, draft_id: d.draft_id, subject: d.subject, body: d.body, variant_class: d.variant_class, source_hash: sha(JSON.stringify(d)) }
})
const out = {
  note: 'Generated by build-seed.mts from data/source; never edited by hand.',
  sources: { 'E1_EXACT_SEQUENCE_STEPS_AND_COPY.md': sha(e1), 'e2_draft_skeletons.json': sha(e2d), 'e2_topic_bank.json': sha(e2t) },
  e1: steps.map((s) => ({ ...s, sequence_label: sequenceLabel(s.sequence) })),
  e2: skeletons,
}
writeFileSync(new URL('library-seed.json', dir), JSON.stringify(out, null, 1) + '\n')
process.stdout.write(`e1 steps ${steps.length}, e2 skeletons ${skeletons.length}\n`)

// The same text, bundled as JSON so the importer can check provenance without reading files at run time.
writeFileSync(new URL('data/source/e1-source-text.json', dir), JSON.stringify({ file: 'E1_EXACT_SEQUENCE_STEPS_AND_COPY.md', text: readFileSync(new URL('data/source/E1_EXACT_SEQUENCE_STEPS_AND_COPY.md', dir), 'utf8') }))
writeFileSync(new URL('data/source/e2-source-text.json', dir), JSON.stringify({ drafts_file: 'e2_draft_skeletons.json', drafts: e2d, topics_file: 'e2_topic_bank.json', topics: e2t }))
