DATABASE_URI=postgres://user:password@host:5432/dbname
PAYLOAD_SECRET=generate-a-long-random-string
NEXT_PUBLIC_SERVER_URL=
# Canonical production host for www/http → https redirects (leave empty locally)
SITE_HOST=
# Local disk uploads when S3_BUCKET is unset: ABSOLUTE path (the standalone server's cwd is not the app dir)
MEDIA_DIR=
# S3-compatible storage (MinIO locally). Leave S3_BUCKET empty to use local disk.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Build/runtime never phones home (R27)
NEXT_TELEMETRY_DISABLED=1
# Comma-separated additional allowed origins for CORS/CSRF (e.g. staging preview domain)
EXTRA_ORIGINS=
# Local/CI seed only. The seed refuses to run with NODE_ENV=production unless SEED_ALLOW_PRODUCTION=1
# (first-run bootstrap of a fresh client deployment only — never against a database with content).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ALLOW_PRODUCTION=

# Turnstile: public site key lives in the `integrations` global; the secret only here. In production both are
# required (fail-closed). Staging/CI may set TURNSTILE_REQUIRED=false to run without Turnstile; the C9 launch
# gate refuses production-launch mode when it is false.
TURNSTILE_SECRET=
TURNSTILE_REQUIRED=true

# Optional salt for hashed IPs in submissions/rate-events (defaults to PAYLOAD_SECRET).
IP_HASH_SALT=

# Publish-time verification (ADR-016/ADR-028 §8): `enforce` refuses publishing unverified content (production default);
# `warn` allows it and logs (default outside production; staging/CI set it explicitly). Launch gate requires enforce.
VERIFICATION_ENFORCEMENT=warn

# Runtime AI (C7, docs/ai-providers.md). OFF by default and requires BOTH this and `integrations.ai.enabled`
# in the CMS. Only `mock` is supported in Releases 1–5; any other name resolves to no provider, and the
# gateway refuses rather than falling back. Provider keys are env-only and never enter a Payload field.
AI_ENABLED=false
AI_PROVIDER=mock
AI_MAX_CALLS_PER_DAY=200
AI_MAX_COST_USD_PER_DAY=5

# ── Containers and edge (C8, docs/deployment-coolify-cloudflare.md) ────────────────────────────────
# Which forwarded-address header the app is allowed to believe. The client address keys the intake
# rate limiter, so trusting a header no proxy overwrites lets any caller mint a fresh bucket per
# request. Fail-closed: unset or unrecognised means trust nothing, and every request without a
# trusted address shares one bucket.
#   cloudflare  reads `cf-connecting-ip` only (Cloudflare in front of the origin — the default for
#               agency-hosted sites; ignores `x-forwarded-for` entirely)
#   xff         first hop of `x-forwarded-for` (a single reverse proxy that OVERWRITES the header)
#   xff-last    last hop of `x-forwarded-for` (a proxy that APPENDS; the nearest trusted hop)
#   none        trust nothing (default; correct for local, CI and any direct-to-origin container)
# Set this only when the origin is genuinely unreachable except through that proxy.
TRUSTED_PROXY=none

# Expose the /dev/* preview routes (component registry, tokens, design system) when NODE_ENV=production.
# The Compose stack and the Playwright projects need it; a public production deployment must leave it unset.
DEV_ROUTES=

# Worker poll interval in ms for the Payload jobs queue (`pnpm --filter @app/syed-ai worker`). Default 2000.
WORKER_INTERVAL_MS=

# Payload GraphQL is disabled unless this is '1' (the REST surface plus the site is all the app needs).
PAYLOAD_GRAPHQL=

# Log every ISR revalidation path (noisy; local debugging only).
PAYLOAD_LOG_REVALIDATE=

# Base URL the Playwright projects run against. Unset means the config starts its own standalone server.
E2E_BASE_URL=

# Notes for a container deployment:
# - The standalone server listens on PORT (default 3000) and HOSTNAME (set 0.0.0.0 in a container);
#   both are read by Next itself, not by this app, and the Dockerfile sets them.
# - `MEDIA_DIR` must be an absolute path on a persistent volume when `S3_BUCKET` is empty; otherwise
#   uploads are lost on redeploy. /api/health reports storage as `fail` when it is not writable.
# - No deploy credential belongs in this file or in any session: production deploys are tag-only
#   (`.github/workflows/deploy.yml`) and the Coolify/Cloudflare tokens live in GitHub Environments.
