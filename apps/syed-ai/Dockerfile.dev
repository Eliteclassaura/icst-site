# syntax=docker/dockerfile:1.7
# Development image (C8). Sources are bind-mounted by Compose; this image only carries the toolchain and
# the installed dependencies, so an edit on the host is live without a rebuild. Never used in production —
# `apps/syed-ai/Dockerfile` builds that, from the same repo root.
#   docker build -f apps/syed-ai/Dockerfile.dev .
FROM node:22-bookworm-slim
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH NEXT_TELEMETRY_DISABLED=1
RUN corepack enable && corepack prepare pnpm@10.28.0 --activate \
 && apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /repo
# Manifests first so `pnpm install` is cached until a dependency actually changes.
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json .npmrc tsconfig.base.json ./
COPY apps/syed-ai/package.json apps/syed-ai/package.json
COPY packages ./packages
COPY tools ./tools
RUN pnpm install --frozen-lockfile
EXPOSE 3000
WORKDIR /repo/apps/syed-ai
CMD ["pnpm", "dev"]
