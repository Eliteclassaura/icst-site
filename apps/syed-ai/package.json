{
  "name": "@factory/syed-ai",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/worker.ts",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "migrate:status": "payload migrate:status",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "design:contract": "tsx ../../packages/design-contract/src/cli.ts from-css ../../legacy-reference/syed-ai-site/assets/css/site.css --client syed-ai --brand syed.ai --public ./public --out ./design/design-contract.json --notes ../../legacy-reference/syed-ai-site/_private/docs/DESIGN-TOKENS.md",
    "design:compile": "tsx ../../packages/design-contract/src/cli.ts compile ./design/design-contract.json --out ./src/design/generated",
    "redirects:build": "tsx scripts/build-redirects.ts",
    "blueprint:validate": "tsx ../../packages/seo-contracts/src/cli.ts validate content/syed-ai.blueprint.json",
    "e2e:fixtures": "tsx scripts/e2e-fixtures.ts"
  },
  "dependencies": {
    "@factory/agency-core": "workspace:*",
    "@factory/design-bundle": "workspace:*",
    "@factory/providers": "workspace:*",
    "@factory/seo-contracts": "workspace:*",
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-s3": "3.88.0",
    "graphql": "^16.11.0",
    "next": "16.3.4",
    "payload": "3.88.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@factory/design-contract": "workspace:*",
    "@factory/eslint-config": "workspace:*",
    "@playwright/test": "1.62.1",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "dotenv": "^16.6.1",
    "pg": "^8.23.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
