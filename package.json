{
  "name": "agency-site-factory",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && pnpm lint:css",
    "lint:css": "stylelint \"packages/**/src/**/*.css\" \"apps/*/src/**/*.css\"",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "gates:scan": "pnpm --filter @factory/quality-gates scan -- ../..",
    "versions:check": "node tools/scripts/check-versions.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm gates:scan && pnpm skills:verify && pnpm versions:check",
    "skills:install": "node tools/scripts/install-skills.mjs",
    "extract:legacy": "tsx tools/legacy-extract/extract.ts",
    "parity:check": "node tools/parity/compare.mjs",
    "qa:report": "node tools/parity/emit-qa-report.mjs",
    "deploy:event": "node tools/parity/emit-deploy-event.mjs",
    "design:bundle": "node tools/design-bundle/run.mjs bundle",
    "design:signature": "node tools/design-bundle/run.mjs signature",
    "design:sync-status": "node tools/design-bundle/run.mjs sync-status",
    "design:pull": "node tools/design-bundle/run.mjs pull",
    "preview:pack": "node tools/design-pack/pack.mjs",
    "residue:scan": "pnpm --filter @factory/quality-gates scan --",
    "skills:verify": "node --test tools/scripts/test/*.test.mjs && node tools/scripts/verify-skills.mjs",
    "design:gates": "node tools/design-bundle/run.mjs gates"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "lighthouse": "^13.4.1",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-use-logical": "2.1.3",
    "tsx": "^4.23.13",
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "ui-ux-pro-max-cli": "2.15.0",
    "ux-ui-agent-skills": "2.5.1",
    "vitest": "5.0.0",
    "yaml": "^2.8.0"
  }
}
