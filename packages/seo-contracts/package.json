{
  "name": "@factory/seo-contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Versioned JSON contracts crossing the OGCS \u2194 Factory boundary (ADR-028). Depends on zod only.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --max-warnings 0",
    "test": "vitest run",
    "validate": "tsx src/cli.ts validate",
    "emit:json-schema": "tsx src/emit-json-schema.ts"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@factory/eslint-config": "workspace:*",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "vitest": "5.0.0"
  }
}
