{
  "$id": "https://factory.local/schemas/blueprint.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 2
    },
    "generatedAt": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "properties": {
        "archive": {
          "type": "string"
        },
        "files": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "extractor": {
          "type": "string"
        },
        "decisions_run_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["archive", "files", "extractor"],
      "additionalProperties": {}
    },
    "site": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "trailingSlash": {
          "type": "boolean"
        }
      },
      "required": ["name", "url", "trailingSlash"],
      "additionalProperties": {}
    },
    "parity": {
      "type": "object",
      "properties": {
        "baseline": {
          "type": "string",
          "enum": ["frozen-old-site", "approved-staging"]
        },
        "accept": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "route": {
                "type": "string"
              },
              "field": {
                "type": "string"
              },
              "value": {},
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["route", "field", "reason"]
          }
        },
        "wordCountBlocking": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "title",
              "description",
              "h1",
              "word_count",
              "schema_type",
              "internal_links",
              "og",
              "canonical"
            ]
          }
        }
      },
      "required": ["baseline"]
    },
    "redirects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": ["string", "null"]
          },
          "status": {
            "anyOf": [
              {
                "type": "number",
                "const": 301
              },
              {
                "type": "number",
                "const": 308
              },
              {
                "type": "number",
                "const": 410
              }
            ]
          },
          "reason": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": ["migration", "manual", "slug-change", "legacy-hash", "automation"]
          }
        },
        "required": ["from", "status"]
      }
    },
    "media": {
      "type": "array",
      "items": {}
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^\\/([a-z0-9-]+\\/)*$"
          },
          "slug": {
            "type": "string",
            "minLength": 1
          },
          "pageType": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "parent": {
            "type": ["string", "null"]
          },
          "seo": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "layout": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "blockType": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["blockType"],
              "additionalProperties": {}
            }
          },
          "decision_ref": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "run_id": {
                    "type": "string",
                    "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                  },
                  "source_url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "action": {
                    "type": "string",
                    "enum": [
                      "PROTECT",
                      "IMPROVE",
                      "REWRITE",
                      "REPOSITION",
                      "CONSOLIDATE",
                      "REDIRECT",
                      "NOINDEX",
                      "PRUNE",
                      "REVIEW"
                    ]
                  }
                },
                "required": ["run_id", "source_url", "action"]
              },
              {
                "type": "null"
              }
            ]
          },
          "migration": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "sourceUrl": {
                    "type": "string",
                    "format": "uri"
                  },
                  "sourceId": {
                    "type": "string"
                  },
                  "sourceSystem": {
                    "type": "string",
                    "enum": ["wordpress", "static-html", "copy-deck", "other"]
                  },
                  "originalTitle": {
                    "type": "string"
                  },
                  "originalMetaDescription": {
                    "type": "string"
                  },
                  "originalH1": {
                    "type": "string"
                  },
                  "originalWordCount": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "contentHash": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "importedAt": {
                    "type": "string"
                  },
                  "decisionsVersion": {
                    "type": "string",
                    "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                  }
                },
                "required": ["sourceUrl"]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["path", "slug", "pageType", "title", "seo", "layout"],
        "additionalProperties": {}
      }
    }
  },
  "required": ["version", "generatedAt", "source", "site", "parity", "redirects", "media", "pages"],
  "additionalProperties": {}
}
