{
  "$id": "https://factory.local/schemas/page-decisions.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract": {
      "type": "string",
      "const": "factory.seo/page-decisions"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "produced_by": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string",
          "enum": ["ogcs", "ses-adapter", "factory-ci", "wordpress-import", "decisions-apply", "factory-app"]
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["system", "version"]
    },
    "produced_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artefact": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": ["artefact", "sha256"]
      }
    },
    "payload": {
      "type": "object",
      "properties": {
        "site": {
          "type": "object",
          "properties": {
            "source_origin": {
              "type": "string",
              "format": "uri"
            },
            "target_origin": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": ["source_origin", "target_origin"],
          "additionalProperties": {}
        },
        "decisions_status": {
          "type": "string",
          "enum": ["draft", "approved"]
        },
        "approved_by": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[^@\\s]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "approved_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_bundle_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "review_window_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source_url": {
                "type": "string",
                "format": "uri"
              },
              "action": {
                "type": "string",
                "enum": [
                  "PROTECT",
                  "IMPROVE",
                  "REWRITE",
                  "REPOSITION",
                  "CONSOLIDATE",
                  "REDIRECT",
                  "NOINDEX",
                  "PRUNE",
                  "REVIEW"
                ]
              },
              "target_url": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uri"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status_code": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "type": "number",
                        "const": 301
                      },
                      {
                        "type": "number",
                        "const": 308
                      },
                      {
                        "type": "number",
                        "const": 410
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "page_type": {
                "type": "string",
                "minLength": 1
              },
              "project_scale_fit": {
                "type": "string",
                "enum": [
                  "mega_industrial",
                  "industrial",
                  "adjacent",
                  "small_commercial",
                  "consumer",
                  "irrelevant",
                  "unknown"
                ]
              },
              "strategic_fit_score": {
                "type": "number",
                "minimum": 0,
                "maximum": 40
              },
              "seo_equity_score": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 40
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "seo_lock": {
                "type": "boolean"
              },
              "prune_blocked": {
                "type": "boolean"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "why_should_this_exist": {
                "type": "string"
              },
              "collection_hint": {
                "type": "string"
              },
              "parity": {
                "type": "object",
                "properties": {
                  "accept": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "title",
                        "description",
                        "h1",
                        "word_count",
                        "schema_type",
                        "internal_links",
                        "og",
                        "canonical"
                      ]
                    }
                  },
                  "word_count_blocking": {
                    "type": "boolean"
                  }
                }
              }
            },
            "required": [
              "source_url",
              "action",
              "page_type",
              "project_scale_fit",
              "strategic_fit_score",
              "seo_equity_score",
              "seo_lock",
              "prune_blocked",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "redirects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": ["string", "null"]
              },
              "status": {
                "anyOf": [
                  {
                    "type": "number",
                    "const": 301
                  },
                  {
                    "type": "number",
                    "const": 308
                  },
                  {
                    "type": "number",
                    "const": 410
                  }
                ]
              },
              "reason": {
                "type": "string"
              },
              "source": {
                "type": "string",
                "enum": ["migration", "manual", "slug-change", "legacy-hash", "automation"]
              }
            },
            "required": ["from", "to", "status", "reason", "source"]
          }
        },
        "information_architecture": {}
      },
      "required": ["site", "decisions_status", "evidence_bundle_sha256", "pages", "redirects"]
    }
  },
  "required": [
    "contract",
    "contract_version",
    "produced_by",
    "produced_at",
    "project_id",
    "run_id",
    "inputs",
    "payload"
  ]
}
